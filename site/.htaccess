<FilesMatch "\.(ndjson|json|log|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

</IfModule>
ErrorDocument 404 /404.html

# Pages must always be revalidated, so a fix is visible the moment it ships.
# Stylesheets and scripts carry a content hash in their URL, so those can be
# kept for a year: a changed file gets a new URL.
<IfModule mod_expires.c>
  <FilesMatch "\.(html|php)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header unset Expires
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
